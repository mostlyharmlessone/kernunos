#
# Load in the platform dependent information
#
include ../../Makefile.inc

# 
# This makefile is recursive. We build subset blas and lapack
# libraries by changing into the blas and lapack directories and
# using the makefiles in these directories. We want to export
# the variables we have set up, like the name of the compiler
# etc
# 
export

#
# Set the directory names 
#
blas_dir := blas
lapack_dir := lapack
libs := $(blas_dir) $(lapack_dir)

#
# and define the library files to be use when building the
# executable files for this chapter.
#
arlibs := $(lapack_dir)/$(lapack_dir).a $(blas_dir)/$(blas_dir).a

#
# Collect all the executable file names together so we only have
# to change things in one place if we add or remove files.
#
executables := exampleLapack77 libf77 exampleLapack90 libf90 \
               exampleLapackInterface exampleLapackModules

.PHONY: all $(libs)
all: $(executables)

#
# We make the actual library files depend upon the directory
# names so we can set up the recursive make in a neat way.
#
$(arlibs): $(libs)

$(libs):
	$(MAKE) --directory=$@
	
#
# Simple example with library code in files using mainly f77
#
exampleLapack77: LapackSrc.o BlasSrc.o

#
# Simple example using mainly f77 + lapack and blas libraries
# 
# Use an explicit rule as we want to use the same driver source
# file but generate an executable of a different name
#
libf77: exampleLapack77.o $(arlibs)
	$(F95) $(F95LINKFLAGS) -o $@ $^

#
# Fortran 90 driver with library codes as source files
# equivalent to simple77 above
#
exampleLapack90: set_precision.o LapackSrc.o BlasSrc.o

#
# Fortran 90 driver with lapack and blas libraries
#
# Use an explicit rule as we want to use the same driver source
# file but generate an executable of a different name
#
libf90: exampleLapack90.o set_precision.o $(arlibs)
	$(F95) $(F95LINKFLAGS) -o $@ $^

#
# Fortran 90 driver with interfaces for blas and lapack routines
# called directly. Linked to libraries
#
exampleLapackInterface: set_precision.o BlasInterface.o \
                        LapackInterface.o $(arlibs)

#
# Fortran 90 driver with modules for blas and lapack routines
# called directly.
#
exampleLapackModules: set_precision.o Background.o BlasModule.o LapackModule.o

# Dependencies of individual .o files

exampleLapack90.o: set_precision.o 

exampleLapackInterface.o: set_precision.o LapackInterface.o \
    BlasInterface.o

exampleLapackModule.o: set_precision.o LapackModule.o \
    BlasModule.o

Background.o: set_precision.o

BlasModule.o: Background.o

LapackModule.o: BlasModule.o

.PHONY: clean extraclean
clean: 
# remove all files generated by the compiler
# these are compiler dependent
	rm -f *.o *.d *.g90 *.mod
# remove all executables
	rm -f $(executables)

#
# extraclean ensures that all generated files are removed. For
# example you would use this if you wished to change compiler
# options and wished this to affect the libraries as well as the
# example program components.
#
extraclean:
# remove all local files generated by the compiler
	rm -f *.o *.d *.g90 *.mod
# remove all executables
	rm -f $(executables)
# and remove all similar files in the library directory
# by running "make clean" in each directory
	for d in $(libs);                \
	do                               \
	  $(MAKE) --directory=$$d clean; \
	done

