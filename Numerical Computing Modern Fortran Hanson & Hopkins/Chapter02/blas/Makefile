.SUFFIXES:

%.o: %.f
	$(F95) $(F77FLAGS) -o $@ -c $<

BLAS_OBJS = dgemm.o dgemv.o dger.o dnrm2.o dscal.o \
	    dswap.o dtrsm.o idamax.o lsame.o xerbla.o

all: blas.a

# Simple example for creating an archive library file
# Using $? instead of $^ means that only those object files that
# are newer than the target archive library will be used. 
blas.a: $(BLAS_OBJS)
	$(AR) $(ARFLAGS) $@ $?
# If RANLIB has been defined then use it.
	$(if $(RANLIB), $(RANLIB) $?) 

.PHONY: clean
clean: 
# remove all files generated by the compiler
# these are compiler dependent
	rm -f *.o *.d *.g90 *.mod
# remove all executables
	rm -f blas.a
