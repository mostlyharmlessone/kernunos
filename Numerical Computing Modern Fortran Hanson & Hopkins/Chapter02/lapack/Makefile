# Makefile to generate a library containing a subset of the
# Lapack library routines.
#
# This is called by the main makefile for Chapter 3 and the
# compiler options, pattern rules etc are inherited from the
# parent.
#

.SUFFIXES:

%.o: %.f
	$(F95) $(F77FLAGS) -o $@ -c $<


LAPACK_OBJS = dgetf2.o dgetrf.o dgetrs.o dlamc1.o dlamc2.o dlamc3.o \
	      dlamc4.o dlamc5.o dlamch.o dlaswp.o ieeeck.o ilaenv.o \
	      iparmq.o

all: lapack.a

# Simple example for creating an archive library file
# Using $? instead of $^ means that only those object files that
# are newer than the target archive library will be used. 

lapack.a: $(LAPACK_OBJS)
# Use ar to generate the library file
	$(AR) $(ARFLAGS) $@ $?
# If RANLIB has been defined then use it.
	$(if $(RANLIB), $(RANLIB) $?)

.PHONY: clean
clean: 
# remove all files generated by the compiler
	rm -f *.o *.d *.g90 *.mod
# remove the library files
	rm -f lapack.a
