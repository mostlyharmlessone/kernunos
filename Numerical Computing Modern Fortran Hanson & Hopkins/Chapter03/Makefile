include ../../Makefile.inc

# Use vpath patterns to pick up source files from
# other chapters, e.g., set_precision, etc
#
# AiryFunPath is the path to the source for CALGO algorithm 838
# which the drivers and subroutines in this chapter use.
AiryFunPath = ./Calgo838

vpath %.f90 ../Chapter02 $(AiryFunPath)

executables = testGeneric testairy testairyInc

all: $(executables)

# testGeneric illustrates the use of the generic module airy
# which allows calls using the generic names while only
# having to remember the name of a single module.
testGeneric: testGeneric.o airy.o set_precision.o airy_functions.o
	$(F95) $(F95LINKFLAGS) -o $@ $^

# Wronskian test of the results of Airy function computations
# on random arguments.
testairy: drive_airy.o Airy_Module.o set_precision.o airy_functions.o
	$(F95) $(F95LINKFLAGS) -o $@ $^

# Same as testairy but uses include files to define airy_module
testairyInc: drive_airy.o Airy_ModuleInc.o set_precision.o airy_functions.o
	$(F95) $(F95LINKFLAGS) -o $@ $^

# Dependencies through USE statements
drive_airy.o : set_precision.o Airy_Module.o

testGeneric.o : set_precision.o airy.o

airy.o: airy_functions.o

# Note the use of the -I flag here to define the path of the include
# files used by the airy_functions source file.
airy_functions.o : airy_functions.f90 set_precision.o 
	$(F95) $(F95FLAGS) -I $(AiryFunPath) -c $<

Airy_Module.o : set_precision.o airy_functions.o

Airy_ModuleInc.o : set_precision.o airy_functions.o sourceReal.txt sourceComplex.txt


.PHONY: clean
clean: 
	# remove all files generated by the compiler
	# these are compiler dependent
	rm -f *.o *.d *.g90 *.mod
	# remove all executables
	rm -f $(executables)
