include ../../Makefile.inc

# Use vpath patterns to pick up source files from
# other chapters, e.g., set_precision, etc
# Could move this into Makefile.inc so one change would
# fix directory name changes.
vpath %.f90 ../Chapter02 ../Chapter06

OBJS = set_precision.o sortElements.o sparseSort.o sparseTypes.o \
       sparseAssign.o sparseOps.o sparseUtils.o  

executables = testSparseStruct

all: $(executables)

testSparseStruct: $(OBJS)

testSparseStruct.o : $(OBJS)

sparseTypes.o : set_precision.o

sparseAssign.o : set_precision.o sortElements.o sparseSort.o \
                 sparseTypes.o

sparseOps.o : set_precision.o sparseTypes.o sparseAssign.o

sparseSort.o : sortElements.o

sparseUtils.o: set_precision.o sparseTypes.o

.PHONY: clean
clean: 
	# remove all files generated by the compiler
	# these are compiler dependent
	rm -f *.o *.d *.g90 *.mod
	# remove all executables
	rm -f testSparseStruct
	# remove any files created for gcov
	rm -f  *.gcda *.gcno
