include ../../Makefile.inc

# Use vpath patterns to pick up source files from
# other chapters, e.g., set_precision, etc
# Could move this into Makefile.inc so one change would
# fix directory name changes.
vpath %.f90 ../Chapter02

executables = testOriginal testType testClass testClassFinalize

all: $(executables)

testOriginal: zeroinOrig.o

testType: set_precision.o brentTypes.o

testClass: set_precision.o brentClass.o brentExtraArgs.o

testClassFinalize: set_precision.o brentClass.o brentExtraArgsFinalize.o

brent.o : set_precision.o

brentTypes.o : set_precision.o

brentExtraArgs.o : set_precision.o brentClass.o

brentClass.o :   set_precision.o


.PHONY: clean
clean: 
	# remove all files generated by the compiler
	# these are compiler dependent
	rm -f *.o *.d *.g90 *.mod
	# remove all executables
	rm -f $(executables)
