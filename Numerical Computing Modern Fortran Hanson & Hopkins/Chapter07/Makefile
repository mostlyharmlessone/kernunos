include ../../Makefile.inc

# Use vpath patterns to pick up source files from
# other chapters, e.g., set_precision, etc
# Could move this into Makefile.inc so one change would
# fix directory name changes.
vpath %.f90 ../Chapter02

executables = testEx1fs testEx1fv testEx2 testEx3 extraTests

all: $(executables)

testEx1fs: set_precision.o quadpack2003.o testModEx1fs.o

testEx1fv: set_precision.o quadpack2003.o testModEx1fs.o

testEx2: set_precision.o quadpack2003.o testModEx2.o

testEx3: set_precision.o quadpack2003.o testModEx3.o

extraTests: set_precision.o quadpack2003.o extraTestsMod.o

testModEx1fs.o : set_precision.o quadpack2003.o

testModEx1fv.o : set_precision.o quadpack2003.o

testModEx2.o : set_precision.o quadpack2003.o

testModEx3.o : set_precision.o quadpack2003.o

extraTestsMod.o : set_precision.o quadpack2003.o

quadpack2003.o : set_precision.o


.PHONY: clean
clean: 
	# remove all files generated by the compiler
	# these are compiler dependent
	rm -f *.o *.d *.g90 *.mod
	# remove all executables
	rm -f $(executables)
