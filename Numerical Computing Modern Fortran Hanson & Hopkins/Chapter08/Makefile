include ../../Makefile.inc

# Use vpath patterns to pick up source files from
# other chapters, e.g., set_precision, etc
# Could move this into Makefile.inc so one change would
# fix directory name changes.
vpath %.f90 ../Chapter02 ../Chapter07

executables = documentExample

all: $(executables)

documentExample: set_precision.o normalPdf.o quadpack2003.o fexternal.o

fexternal.o : set_precision.o normalPdf.o

normalPdf.o : set_precision.o quadpack2003.o

quadpack2003.o : set_precision.o


.PHONY: clean
clean: 
	# remove all files generated by the compiler
	# these are compiler dependent
	rm -f *.o *.d *.g90 *.mod
	# remove all executables
	rm -f $(executables)
