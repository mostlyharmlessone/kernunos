include ../../Makefile.inc

# Use vpath patterns to pick up source files from
# other chapters, e.g., set_precision, etc
# Could move this into Makefile.inc so one change would
# fix directory name changes.
vpath %.f90 ../Chapter02 

executables = book_test

all: $(executables)

rh_test: set_precision.o nrm2_ieee.o  

book_test: set_precision.o dnrm2_testmod.o dnrm2_ieee.o

dnrm2_testmod.o: dnrm2_ieee.o

nrm2_ieee.o : set_precision.o


.PHONY: clean
clean: 
	# remove all files generated by the compiler
	# these are compiler dependent
	#
	# Explicitly remove dnrm2_support.f90 as it is
	# generated via a pre-processor
	rm -f *.o *.d *.g90 *.mod 
	# remove all executables
	rm -f $(executables)
