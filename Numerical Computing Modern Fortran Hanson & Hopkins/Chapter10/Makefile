include ../../Makefile.inc

# Use vpath patterns to pick up source files from
# other chapters, e.g., set_precision, etc
# Could move this into Makefile.inc so one change would
# fix directory name changes.
vpath %.f90 ../Chapter02 
vpath %.f ../Chapter02 

executables = dgemm_main saxpy_main charplay c_sam syscall arrayOfPtrs

all: $(executables)

dgemm_main: dgemm.o lsame.o xerbla.o set_precision.o

saxpy_main: CInterSaxpy.o saxpy.o

charplay: stringplay.o

c_sam: funptrs.o

syscall: csyscall.o

arrayOfPtrs: PtrArray.o

Background.o: set_precision.o

.PHONY: clean
clean: 
	# remove all files generated by the compiler
	# these are compiler dependent
	#
	rm -f *.o *.d *.g90 *.mod 
	# remove all executables
	rm -f $(executables)
