include ../../Makefile.inc

# Use vpath patterns to pick up source files from
# other chapters, e.g., set_precision, etc
# Could move this into Makefile.inc so one change would
# fix directory name changes.
vpath %.f90 ../Chapter02 ../Chapter04 ../Chapter06

executables = testSLUInterop

SuperLULib = libsuperlu_4.3.a

all: $(executables)

OBJS = set_precision.o sparseTypes.o sortElements.o \
       sparseSort.o sparseAssign.o  sparseOps.o \
       sluInterop.o fortran_double_call_SuperLU.o \
       testSLUInterop.o

testSLUInterop: $(OBJS) $(SuperLULib) $(LIBS)
	$(F95) $(F95LINKFLAGS) -o $@ $^

testSLUInterop.o: set_precision.o sparseTypes.o sortElements.o \
                  sparseSort.o sparseAssign.o  sparseOps.o \
	          sluInterop.o fortran_double_call_SuperLU.o

sluInterop.o: set_precision.o sparseTypes.o

sparseTypes.o : set_precision.o

sparseOps.o : set_precision.o sparseTypes.o

sparseAssign.o : set_precision.o sortElements.o sparseSort.o \
                 sparseTypes.o

sparseSort.o :   sortElements.o

set_precision.o:

# The C interface routines to connect the SuperLU C library to
# the Fortran code

fortran_double_call_SuperLU.o: slu_ddefs.h

slu_ddefs.h: slu_Cnames.h supermatrix.h slu_util.h

slu_util.h: superlu_enum_consts.h

.PHONY: clean
clean: 
	# remove all files generated by the compiler
	# these are compiler dependent
	rm -f *.o *.d *.g90 *.mod
	# remove all executables
	rm -f $(executables)
