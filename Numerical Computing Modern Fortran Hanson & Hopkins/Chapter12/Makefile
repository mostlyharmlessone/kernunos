include Makefile.inc

# Use vpath patterns to pick up source files from
# other chapters, e.g., set_precision, etc
# Could move this into Makefile.inc so one change would
# fix directory name changes.
vpath %.f90 ../Chapter02 ../Chapter04 ../Chapter06 ../Chapter11
vpath %.f ../Chapter02
vpath %.c ../Chapter11

OBJS = set_precision.o Background.o BlasModule.o sortElements.o \
	   sparseSort.o sparseTypes.o  sparseAssign.o \
	   sparseOps.o  sparseUtils.o sluInterop.o \
           fortran_double_call_SuperLU.o

executables = driverAiryBVP driverPiecewiseLinear

SuperLULib = /usr/local/lib/libsuperlu.so
LIBS = /usr/lib/libblas.so

all: $(executables)

driverPiecewiseLinear: $(OBJS) driverPiecewiseLinear.o $(SuperLULib) $(LIBS)
	$(F95) $(F95LINKFLAGS) -o $@ $^

driverAiryBVP: $(OBJS) driverAiryBVP.o $(SuperLULib) $(LIBS)
	$(F95) $(F95LINKFLAGS) -o $@ $^

driverPiecewiseLinear.o: set_precision.o sortElements.o \
               sparseSort.o sparseTypes.o  sparseAssign.o \
               sparseOps.o  sparseUtils.o sluInterop.o

driverAiryBVP.o: set_precision.o sortElements.o \
               sparseSort.o sparseTypes.o  sparseAssign.o \
               sparseOps.o  sparseUtils.o sluInterop.o

set_precision.o : 

sparseTypes.o : set_precision.o

sparseAssign.o : set_precision.o sortElements.o sparseSort.o \
                 sparseTypes.o

sparseOps.o : set_precision.o sparseTypes.o

sparseUtils.o: set_precision.o sparseTypes.o

sparseSort.o :   sortElements.o


.PHONY: clean
clean: 
	# remove all files generated by the compiler
	# these are compiler dependent
	rm -f *.o *.d *.g90 *.mod
	# remove all executables
	rm -f testSparseStruct
