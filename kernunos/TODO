nvidia compiler flags -fast -mp=gpu -gpu=cc80  (openMP offload to gpu, source NSERC, 
also recommend "teams" directive not  "target parallel for" in c++
OpenMP 4 
#pragma omp target teams distribute parallel for 
for (int i = 0; i < N; i++) a[i]=b[i]+ scalar * c[i]; 
OpenMP 5.0
#pragma omp target teams loop
for (int i = 0; i < N; i++) a[i]=b[i]+ scalar * c[i];)

tiff support

https://www.ncbi.nlm.nih.gov/IEB/ToolBox/CPP_DOC/lxr/source/src/util/image/image_io_tiff.cpp
void CImageIOTiff::WriteImage(const CImage& image, CNcbiOstream& ostr,
                              size_t x, size_t y, size_t w, size_t h,
                              CImageIO::ECompress compress)
{
    CRef<CImage> subimage(image.GetSubImage(x, y, w, h));
    WriteImage(*subimage, ostr, compress);
}

or
#include "tiffio.h"
#include <vector>

void saveBufferAsTiff(const char* filename, uint32_t width, uint32_t height, unsigned char* buffer) {
    TIFF* tif = TIFFOpen(filename, "w");
    if (!tif) return;

    // Set basic TIFF tags
    TIFFSetField(tif, TIFFTAG_IMAGEWIDTH, width);
    TIFFSetField(tif, TIFFTAG_IMAGELENGTH, height);
    TIFFSetField(tif, TIFFTAG_SAMPLESPERPIXEL, 1); // 1 for Grayscale, 3 for RGB
    TIFFSetField(tif, TIFFTAG_BITSPERSAMPLE, 8);
    TIFFSetField(tif, TIFFTAG_ORIENTATION, ORIENTATION_TOPLEFT);
    TIFFSetField(tif, TIFFTAG_PLANARCONFIG, PLANARCONFIG_CONTIG);
    TIFFSetField(tif, TIFFTAG_PHOTOMETRIC, PHOTOMETRIC_MINISBLACK);

    // Write the buffer row by row
    for (uint32_t row = 0; row < height; row++) {
        if (TIFFWriteScanline(tif, buffer + (row * width), row, 0) < 0) break;
    }

    TIFFClose(tif);
}










