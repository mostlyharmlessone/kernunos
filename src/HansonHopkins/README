#!/bin/sh
#need to execute this in original H & H directory, path to kernunos needs to be correct
#The code in this directory is modified or taken from multiple chapters of http://www.siam.org/books/ot134 
#Numerical Computing with Modern Fortran Richard J.Hanson and Tim Hopkins SIAM, specifically 2,4,6,11 and 12

#Code from Chapter 2, ie. set_precision.f90 and LapackInterface.f90 are modified slightly from the original versions in the text. 
#Code from Chapter 4 has patches presented here to include the Compressed Spare Row format.
#Code related to using superLU is based on the code from Chapter 12. The patches allow the code to be compatible with version > 5 of the SuperLU package, 
#the original source from Chapter 11 of H&H was compatible with version 4.3  An additional patch was also added for cmake build compatibility.

#patchs generated by e.g.
diff -u Chapter02/set_precision.f90 ../../kernunos/src/HansonHopkins/set_precision.f90 > set_precision.f90_patch
diff -u Chapter02/LapackInterface.f90 ../../kernunos/src/HansonHopkins/LapackInterface.f90 > LapackInterface.f90_patch
diff -u Chapter04/sparseAssign.f90 ../../kernunos/src/HansonHopkins/sparseAssign.f90 > sparseAssign.f90_patch
diff -u Chapter04/sparseUtils.f90 ../../kernunos/src/HansonHopkins/sparseUtils.f90 > sparseUtils.f90_patch
diff -u Chapter04/sparseOps.f90 ../../kernunos/src/HansonHopkins/sparseOps.f90 > sparseOps.f90_patch
diff -u Chapter04/sparseTypes.f90 ../../kernunos/src/HansonHopkins/sparseTypes.f90 > sparseTypes.f90_patch
diff -u Chapter11/fortran_double_call_SuperLU.c ../../kernunos/src/HansonHopkins/fortran_double_call_SuperLU.c > fortran_double_call_SuperLU.c_patch
diff -u Chapter11/slu_ddefs.h ../../kernunos/src/HansonHopkins/slu_ddefs.h > slu_ddefs.h_patch